# Copy this file to .env and change the values. .env is never committed.

# Staff password for uploading and editing lessons (Studio and write API).
# Use a long random value, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(24))"
# Empty = staff actions are switched off.
FIDEL_STAFF_TOKEN=

# Biggest video upload allowed, in MB.
FIDEL_MAX_UPLOAD_MB=1024

# Public address of this server, used in lesson file links.
# Leave empty to use the address the request came in on.
FIDEL_PUBLIC_URL=

# Websites allowed to embed the player, comma-separated ("*" = any).
FIDEL_ALLOWED_ORIGINS=*

# AI engines. Everything runs on this server; nothing is sent elsewhere.
#   Speech-to-text: local_whisper | none
FIDEL_STT_PROVIDER=local_whisper
#   Whisper size: tiny | base | small | medium (bigger = better but slower)
FIDEL_WHISPER_MODEL=small
#   English -> Amharic draft translation: local_madlad | none
FIDEL_TRANSLATOR=local_madlad

# Port on this computer (default 8000).
FIDEL_PORT=8000

# Network address to listen on. 0.0.0.0 = whole network (laptop demos, phone tests);
# 127.0.0.1 = this computer only (a server behind Caddy/nginx).
FIDEL_BIND=0.0.0.0
